# Keep this file mode 0640, owned by root:rf. Leave empty when DNS/ACME is off.
# CF_API_TOKEN=replace-with-a-zone-scoped-cloudflare-api-token
# Optional read-only token for private GitHub repositories. It stays node-local
# and is never replicated or exposed to build commands.
# RF_GITHUB_TOKEN=<replace-with-read-only-contents-token>
# Preferred private-repository/PR integration. The private key is the base64
# encoding of the PEM file, not the PEM path. Keep all three node-local.
# RF_GITHUB_APP_ID=replace-with-numeric-app-id
# RF_GITHUB_APP_PRIVATE_KEY_B64=replace-with-base64-encoded-pem
# RF_GITHUB_APP_WEBHOOK_SECRET=replace-with-random-webhook-secret
# DKIM private keys are optional and node-local. Name each variable in the
# signed email-domain definition (it must start with RF_EMAIL_DKIM_), then put
# the PEM value only in the installed /etc/rf.env. Never commit the value.
