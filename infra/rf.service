[Unit]
Description=RandallFlare edge node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rf
Group=rf
WorkingDirectory=/var/lib/rf
StateDirectory=rf
StateDirectoryMode=0700
Environment=RUST_LOG=info,chitchat=warn
EnvironmentFile=-/etc/rf.env
ExecStartPre=/usr/local/bin/rf doctor --config /etc/rf.toml
ExecStart=/usr/local/bin/rf run --config /etc/rf.toml
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077

# Bind HTTP/HTTPS without running rf or its workerd children as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
# bubblewrap creates a fresh procfs inside its user/mount namespace. systemd's
# procfs masking for these two options makes that nested mount "too revealing"
# and the kernel rejects it. The daemon remains unprivileged with NNP, a
# one-capability bounding set, private devices, and a read-only host filesystem;
# build commands receive bubblewrap's fresh /proc and /dev instead.
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectKernelLogs=false
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
